# ─── DATABASE ─────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/advocate_platform"

# ─── JWT SECRETS (Use RS256 keypair in production; HS256 for dev) ─────────────
JWT_ACCESS_SECRET="CHANGE_ME_access_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxxx"
JWT_REFRESH_SECRET="CHANGE_ME_refresh_secret_min_64_chars_xxxxxxxxxxxxxxxxxxxxxxxxxx"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── SERVER ───────────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
API_BASE_URL="http://localhost:4000"
FRONTEND_URL="http://localhost:3000"
ALLOWED_ORIGINS="http://localhost:3000"

# ─── S3-COMPATIBLE STORAGE ────────────────────────────────────────────────────
STORAGE_PROVIDER="local"           # "s3" | "r2" | "local"
AWS_ACCESS_KEY_ID="your-access-key"
AWS_SECRET_ACCESS_KEY="your-secret-key"
AWS_REGION="ap-south-1"
AWS_S3_BUCKET="advocate-platform-docs"
# For Cloudflare R2:
# R2_ACCOUNT_ID="your-account-id"
# R2_ENDPOINT="https://<account_id>.r2.cloudflarestorage.com"

# ─── ADMIN SEED ───────────────────────────────────────────────────────────────
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="Admin@123456"

# ─── SITE CONFIG (override DB settings at startup) ───────────────────────────
SITE_NAME="[FIRM_NAME]"
SITE_URL="https://example.com"
SITE_TAGLINE="Expert Legal Counsel You Can Trust"
CONTACT_EMAIL="contact@example.com"
CONTACT_PHONE="+91 XXXXX XXXXX"
OFFICE_ADDRESS="[Office Address], [City], [State] - [PIN]"
PRIMARY_COLOR="#1a365d"
DEFAULT_SEO_TITLE="[FIRM_NAME] — Expert Legal Services"
DEFAULT_META_DESC="[FIRM_NAME] provides expert legal counsel across criminal, family, property, and civil law matters."

# ─── GOOGLE ───────────────────────────────────────────────────────────────────
GOOGLE_SITE_VERIFICATION=""
ANALYTICS_ID=""

# ─── EMAIL (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="noreply@example.com"
SMTP_PASS="your-smtp-password"
EMAIL_FROM_NAME="[FIRM_NAME]"

# ─── RATE LIMITING ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5

# ─── COURT INTEGRATION PROVIDERS ─────────────────────────────────────────────
ENABLED_COURT_PROVIDERS="MANUAL"
# Add more as authorized: "MANUAL,ECOURTS_API"
# ECOURTS_API_KEY=""
